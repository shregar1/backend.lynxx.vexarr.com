# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

# ── Required ─────────────────────────────────────────────────────────────────

project_id      = "my-gcp-project-id"          # gcloud projects list
tf_state_bucket = "my-project-tfstate"          # GCS bucket you created manually
domain          = "api.lynxx.dev"
website_domain  = "lynxx.dev"
dashboard_domain = "app.lynxx.dev"
db_password     = "CHANGE_ME_strong_password"   # also set TF_VAR_db_password in CI

# ── Optional overrides ────────────────────────────────────────────────────────

region           = "us-central1"
zone             = "us-central1-a"
environment      = "prod"
cluster_name     = "lynxx-cluster"
db_instance_name = "lynxx-postgres"

# db-f1-micro for staging / db-perf-optimized-N-2 for prod
db_tier          = "db-perf-optimized-N-2"

gateway_replicas = 2
plan_tier        = "pro"   # free | pro | business | enterprise
